{
  "name": "astra",
  "version": "0.1.0",
  "description": "Astra – Werkzeugsammlung für macOS (u. a. ein voll ausgestatteter PDF-Editor)",
  "author": "Jonathan Weidner",
  "license": "AGPL-3.0-or-later",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs && node scripts/build-ocr-helper.mjs && node scripts/build-cal-helper.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "node scripts/copy-assets.mjs && node scripts/build-ocr-helper.mjs && node scripts/build-cal-helper.mjs",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/run-selftest.mjs",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "predist": "node scripts/copy-assets.mjs && node scripts/build-ocr-helper.mjs && node scripts/build-cal-helper.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "predist:dir": "node scripts/copy-assets.mjs && node scripts/build-ocr-helper.mjs && node scripts/build-cal-helper.mjs",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir",
    "icon": "node scripts/make-icon.mjs",
    "tray-icon": "node scripts/make-tray-icon.mjs",
    "ocr-helper": "node scripts/build-ocr-helper.mjs --force",
    "cal-helper": "node scripts/build-cal-helper.mjs --force",
    "test-pdf": "node scripts/make-test-pdf.mjs",
    "copy-assets:force": "node scripts/copy-assets.mjs --force"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@zxing/library": "^0.21.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "immer": "^10.1.1",
    "jsbarcode": "^3.12.3",
    "mammoth": "^1.12.2",
    "marked": "^14.1.4",
    "mupdf": "^1.25.0",
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
