{
  "name": "pdf-studio",
  "version": "0.1.0",
  "description": "PDF Studio – ein voll ausgestatteter PDF-Editor für macOS",
  "author": "Jonathan Weidner",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir",
    "icon": "node scripts/make-icon.mjs",
    "test-pdf": "node scripts/make-test-pdf.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "mupdf": "^1.25.0",
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
